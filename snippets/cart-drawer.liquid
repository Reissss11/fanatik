<!-- Slideout Cart Drawer Container -->
{%- assign non_surcharge_count = 0 -%}
{%- for item in cart.items -%}
  {%- if item.variant_id != 54006710763861 and item.variant_id != 54006710829397 -%}
    {%- assign non_surcharge_count = non_surcharge_count | plus: item.quantity -%}
  {%- endif -%}
{%- endfor -%}

<div class="cart-overlay" id="CartDrawerOverlay" style="display: none;">
  <div class="cart-drawer" id="CartDrawerElement">
    <!-- Header -->
    <div class="cart-header">
      <h2>Carrinho (<span id="CartDrawerCount">{{ non_surcharge_count }}</span>)</h2>
      <button class="close-btn" id="CartDrawerCloseBtn" aria-label="Fechar carrinho">✕</button>
    </div>

    <!-- Items Container -->
    <div class="cart-items" id="CartDrawerItems">
      {%- if non_surcharge_count == 0 -%}
        <div class="empty-cart">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="empty-icon">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <p>{{ 'general.cart.empty' | t }}</p>
          <button class="start-shopping-btn" id="CartDrawerStartShoppingBtn">Começar a comprar</button>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          {%- if item.variant_id == 54006710763861 or item.variant_id == 54006710829397 -%}
            {%- continue -%}
          {%- endif -%}
          <div class="cart-item" data-key="{{ item.key }}">
            <!-- Item Image -->
            <div class="cart-item-image">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.product.title | escape }}">
              {%- endif -%}
            </div>

            <!-- Item Info -->
            <div class="cart-item-info">
              <h4>{{ item.product.title | escape }}</h4>
              
              <!-- Meta (Size / Season) -->
              <p class="item-meta">
                {%- unless item.product.has_only_default_variant -%}
                  Tamanho: {{ item.variant.title | escape }}
                {%- endunless -%}
                {%- assign season_value = item.product.metafields.custom.season -%}
                {%- if season_value != blank -%}
                  | {{ season_value }}
                {%- endif -%}
              </p>

              <!-- Personalization properties -->
              {%- assign custom_name = item.properties['Nome'] -%}
              {%- assign custom_number = item.properties['Número'] -%}
              {%- if custom_name != blank or custom_number != blank -%}
                <p class="item-customization">
                  Personalização: {{ custom_name }} {{ custom_number }}
                </p>
              {%- endif -%}

              <!-- Patches list -->
              {%- assign patches = item.properties['Patches'] | default: item.properties['Patch'] -%}
              {%- if patches != blank -%}
                {%- assign patches_array = patches | split: "," -%}
                {%- assign patches_count = 0 -%}
                {%- for p in patches_array -%}
                  {%- assign clean_p = p | strip -%}
                  {%- if clean_p != blank -%}
                    {%- assign patches_count = patches_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if patches_count > 0 -%}
                  <div class="item-patches-list">
                    <span class="item-patch">
                      Patches: {{ patches }}
                    </span>
                  </div>
                {%- endif -%}
              {%- endif -%}

              <!-- Price & Quantity row -->
              <div class="item-price-row">
                <span class="item-price">{{ item.final_line_price | money | replace: "€", "" | strip | append: " €" }}</span>
                
                <div class="qty-selector">
                  <button type="button" class="qty-btn minus" data-qty-change="-1">-</button>
                  <input
                    type="number"
                    value="{{ item.quantity }}"
                    min="0"
                    class="qty-input"
                    data-key="{{ item.key }}"
                  >
                  <button type="button" class="qty-btn plus" data-qty-change="1">+</button>
                </div>
              </div>
            </div>

            <!-- Remove Button -->
            <button
              class="remove-btn"
              data-key="{{ item.key }}"
              aria-label="Remover artigo"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
            </button>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Footer Summary (Only visible if items in cart) -->
    <div class="cart-footer" id="CartDrawerFooter" {% if non_surcharge_count == 0 %}style="display: none;"{% endif %}>
      {%- if non_surcharge_count >= 3 -%}
        <!-- Multi-item discount notice -->
        <div class="discount-message" id="CartDrawerDiscountMessage">
          🎉 Desconto aplicado: Poupa na compra conjunta das tuas camisolas!
        </div>
      {%- endif -%}

      <div class="summary-row">
        <span>Subtotal</span>
        <span id="CartDrawerSubtotal">{{ cart.total_price | money | replace: "€", "" | strip | append: " €" }}</span>
      </div>

      {%- if cart.cart_level_discount_applications.size > 0 -%}
        <div id="CartDrawerDiscountsContainer">
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="summary-row discount">
              <span>Desconto ({{ discount.title }})</span>
              <span>-{{ discount.total_allocated_amount | money | replace: "€", "" | strip | append: " €" }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="summary-row total">
        <span>Total</span>
        <span id="CartDrawerTotal">{{ cart.total_price | money | replace: "€", "" | strip | append: " €" }}</span>
      </div>

      <a href="/checkout" class="checkout-link">
        <button class="checkout-btn" id="CartDrawerCheckoutBtn">
          Finalizar Compra
        </button>
      </a>
    </div>
  </div>
</div>
