<!-- Sections Javascript Scoped for Homepage Reviews -->
<script>
function initHomepageReviews() {
  const section = document.querySelector('.homepage-reviews-section');
  if (!section) return;

  const globalReviewsKey = 'fanatik_global_homepage_reviews';
  const deletedReviewsKey = 'fanatik_deleted_review_ids';

  // Admin moderation check
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('admin') === 'true') {
    localStorage.setItem('fanatik_admin_moderation', 'true');
  } else if (urlParams.get('admin') === 'false') {
    localStorage.removeItem('fanatik_admin_moderation');
  }
  const isAdminMode = localStorage.getItem('fanatik_admin_moderation') === 'true';
  let deletedReviewIds = JSON.parse(localStorage.getItem(deletedReviewsKey) || '[]');

  // Base overall mock stats
  const baseTotalCount = 283;
  const baseAvgRating = 4.7;
  const baseDistribution = {
    5: 226,
    4: 45,
    3: 9,
    2: 2,
    1: 1
  };

  // PT-PT Name pools for deterministic generator
  const firstNames = [
    "Carlos", "Ana", "Luís", "Vítor", "Beatriz", "José", "Rui", "Cláudia", "Tiago", "Diana",
    "Marco", "Sara", "Pedro", "Maria", "João", "Filipa", "Ricardo", "Inês", "Miguel", "Sofia",
    "António", "Rita", "Francisco", "Mariana", "Gonçalo", "Leonor", "Diogo", "Madalena", "Gustavo", "Carolina",
    "Daniel", "Catarina", "Nuno", "Patrícia", "André", "Joana", "Jorge", "Marta", "Manuel", "Camila"
  ];
  const lastNames = [
    "Mendes", "Henriques", "Abreu", "Pereira", "Santos", "Rodrigues", "Moreira", "Silva", "Gomes", "Costa",
    "Antunes", "Oliveira", "Martins", "Sousa", "Fernandes", "Lopes", "Pinto", "Carvalho", "Teixeira", "Ribeiro",
    "Correia", "Cardoso", "Ferreira", "Almeida", "Marques", "Alves", "Rocha", "Pires", "Cruz", "Fonseca",
    "Soares", "Cunha"
  ];

  // PT-PT Short snappy review templates
  const templates = [
    { rating: 5, title: "Excelente qualidade!", comment: "Camisola fantástica. Tecido soberbo, personalização oficial e envio super rápido." },
    { rating: 5, title: "Edição especial incrível", comment: "Os detalhes retro estão perfeitos. O apoio ao cliente ajudou-me imenso." },
    { rating: 4, title: "Linda, mas pequeno atraso", comment: "Acabamentos excelentes. O envio atrasou 1 dia, mas a qualidade compensa a 100%." },
    { rating: 5, title: "Loja de confiança", comment: "É o terceiro pedido e a qualidade nunca falha. Tecido leve e muito resistente." },
    { rating: 4, title: "Excelente tecido", comment: "Emblemas impecáveis. O tamanho ficou um pouco justo, mas serve bem. Chegou rápido." },
    { rating: 5, title: "Como a oficial!", comment: "Qualidade idêntica à oficial por um preço imbatível. Chegou muito bem embalada." },
    { rating: 5, title: "Personalização de topo", comment: "O nome e número vêm com a fonte oficial. Tudo muito limpo e bem colado." },
    { rating: 5, title: "Super confortável", comment: "A versão de adepto é super confortável para o dia a dia. Costuras impecáveis." },
    { rating: 4, title: "Qualidade 10/10", comment: "Camisola de jogador premium. Demorou 2 dias a mais, mas a camisola é espetacular." },
    { rating: 5, title: "Brutal!", comment: "A edição especial é linda. Todos os bordados perfeitos. Voltarei a comprar." },
    { rating: 5, title: "Atendimento exemplar", comment: "Tive dúvidas no tamanho e responderam-me em minutos. Super atenciosos!" },
    { rating: 5, title: "Perfeição nos detalhes", comment: "Os acabamentos são de alta qualidade. Excelente caimento e muito respirável." },
    { rating: 5, title: "Espetacular!", comment: "Muito melhor do que esperava. O tecido é super fresco e os detalhes incríveis." },
    { rating: 4, title: "Demorou mas valeu a pena", comment: "Chegou um pouco fora do prazo estimado, mas a camisola é linda e de grande qualidade." },
    { rating: 5, title: "Compra perfeita", comment: "Tudo cinco estrelas. Rapidez no envio e produto impecável." },
    { rating: 5, title: "Recomendo vivamente", comment: "O tecido é espetacular e a estampagem de alta durabilidade. Já lavei e está como nova!" },
    { rating: 5, title: "Cores fantásticas", comment: "As cores e os emblemas estão espetaculares. Veste muito bem." },
    { rating: 4, title: "Muito boa qualidade", comment: "Super macia e confortável. Um ligeiro atraso na transportadora mas correu tudo bem." },
    { rating: 5, title: "Preço/Qualidade imbatível", comment: "Por este preço não se encontra nada melhor. A qualidade é simplesmente fantástica." },
    { rating: 5, title: "Estou impressionado", comment: "Não esperava que fosse tão idêntica à original. Os detalhes são incríveis!" },
    { rating: 5, title: "Melhor do que esperava", comment: "O tecido de jogador assenta super bem. Muito leve e respirável." },
    { rating: 5, title: "Recomendo sem dúvidas", comment: "Envio rápido, embalagem excelente e camisola perfeita. 5 estrelas!" },
    { rating: 4, title: "Boa compra", comment: "Gostei muito. Tecido bom e acabamentos de qualidade. Chegou tudo certinho." },
    { rating: 5, title: "Top, top!", comment: "A personalização ficou excelente. O lettering oficial faz toda a diferença." }
  ];

  // Base list
  const baseReviewsPool = [];
  
  // Seed function
  function seededRandom(seed) {
    const x = Math.sin(seed) * 10000;
    return x - Math.floor(x);
  }

  // Generate 80 reviews deterministically using deterministic seeded random indexes
  for (let i = 0; i < 80; i++) {
    const nameIdx = Math.floor(seededRandom(i * 12.3 + 1.1) * firstNames.length);
    const lastIdx = Math.floor(seededRandom(i * 45.6 + 2.2) * lastNames.length);
    const tempIdx = Math.floor(seededRandom(i * 78.9 + 3.3) * templates.length);
    const daysAgo = Math.floor(seededRandom(i * 99.1 + 4.4) * 5); // 0 (Hoje) to 4 days ago

    baseReviewsPool.push({
      id: `global_seeded_${i}`,
      name: `${firstNames[nameIdx]} ${lastNames[lastIdx]}`,
      rating: templates[tempIdx].rating,
      title: templates[tempIdx].title,
      comment: templates[tempIdx].comment,
      daysAgo: daysAgo,
      verified: true
    });
  }

  // Sort baseReviewsPool so more recent reviews are first
  baseReviewsPool.sort((a, b) => a.daysAgo - b.daysAgo);

  // Format dates nicely
  baseReviewsPool.forEach(rev => {
    if (rev.daysAgo === 0) {
      rev.date = "Hoje";
    } else if (rev.daysAgo === 1) {
      rev.date = "Ontem";
    } else {
      rev.date = `Há ${rev.daysAgo} dias`;
    }
  });

  // Load custom reviews from localStorage
  let customReviews = JSON.parse(localStorage.getItem(globalReviewsKey) || '[]');
  let activeModalRating = 5;

  // Modal open / close handlers
  const openModalBtn = document.getElementById('GlobalReviewFormBtn');
  const modalOverlay = document.getElementById('GlobalReviewModal');
  const closeModalBtn = document.getElementById('CloseGlobalReviewModalBtn');

  if (openModalBtn && modalOverlay) {
    openModalBtn.addEventListener('click', () => {
      modalOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    });

    // Auto-open modal if URL parameter ?review=true is present
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('review')) {
      modalOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
      
      const orderIdParam = urlParams.get('order_id');
      if (orderIdParam) {
        const orderInput = document.getElementById('ModalOrderId');
        if (orderInput) orderInput.value = decodeURIComponent(orderIdParam);
      }
    }
  }

  if (closeModalBtn && modalOverlay) {
    closeModalBtn.addEventListener('click', () => {
      modalOverlay.classList.remove('open');
      document.body.style.overflow = '';
    });
    
    // Click outside modal card to close
    modalOverlay.addEventListener('click', (e) => {
      if (e.target === modalOverlay) {
        modalOverlay.classList.remove('open');
        document.body.style.overflow = '';
      }
    });
  }

  // Handle modal rating select stars
  const modalStarBtns = document.querySelectorAll('#ModalRatingStars .modal-star-btn');
  modalStarBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const rating = parseInt(this.getAttribute('data-rating'));
      activeModalRating = rating;
      
      modalStarBtns.forEach(b => {
        const bRating = parseInt(b.getAttribute('data-rating'));
        if (bRating <= rating) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });
    });
  });

  // Handle form submit
  const modalForm = document.getElementById('HomepageSubmitReviewForm');
  if (modalForm) {
    modalForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const name = document.getElementById('ModalName').value.trim();
      const comment = document.getElementById('ModalComment').value.trim();
      
      if (!name || !comment) return;

      const newReview = {
        id: 'global_custom_' + Date.now(),
        name: name,
        rating: activeModalRating,
        title: "",
        comment: comment,
        date: "Hoje",
        verified: true,
        orderId: "",
        timestamp: Date.now()
      };

      // Add to custom reviews list
      customReviews.unshift(newReview);
      localStorage.setItem(globalReviewsKey, JSON.stringify(customReviews));

      // Reset & close modal
      modalForm.reset();
      modalOverlay.classList.remove('open');
      document.body.style.overflow = '';
      activeModalRating = 5;
      modalStarBtns.forEach(b => b.classList.add('active'));

      // Show popup notification
      showSuccessPopup("Avaliação submetida com sucesso! Obrigado pelo feedback.");

      // Re-run stats & render
      calculateStatsAndRender();
    });
  }

  function showSuccessPopup(message) {
    const popup = document.createElement('div');
    popup.className = 'review-submitted-success-popup';
    popup.innerHTML = `
      <span>✓</span>
      <span>${message}</span>
    `;
    document.body.appendChild(popup);
    
    setTimeout(() => {
      popup.style.opacity = '0';
      popup.style.transform = 'translateY(20px)';
      popup.style.transition = 'all 0.4s ease';
      setTimeout(() => popup.remove(), 400);
    }, 3600);
  }

  // Calculate and Render
  function calculateStatsAndRender() {
    // Recalculate deleted reviews offset
    let deletedCount = 0;
    deletedReviewIds.forEach(id => {
      deletedCount++;
    });
    const totalCount = Math.max(0, baseTotalCount + customReviews.length - deletedCount);
    
    const filteredBasePool = baseReviewsPool.filter(rev => !deletedReviewIds.includes(rev.id));
    const filteredCustomPool = customReviews.filter(rev => !deletedReviewIds.includes(rev.id));
    
    let totalSum = baseTotalCount * baseAvgRating;
    baseReviewsPool.forEach(rev => {
      if (deletedReviewIds.includes(rev.id)) {
        totalSum -= rev.rating;
      }
    });
    filteredCustomPool.forEach(rev => {
      totalSum += rev.rating;
    });

    const avgRating = totalCount > 0 ? (totalSum / totalCount).toFixed(1) : "0.0";

    // Update Header
    const scoreNumEl = document.getElementById('GlobalAvgRating');
    const totalTextEl = document.getElementById('GlobalTotalCountText');
    if (scoreNumEl) scoreNumEl.innerText = avgRating;
    if (totalTextEl) totalTextEl.innerText = `Excelente (baseado em ${totalCount} avaliações)`;

    // Render Cards in Carousel Track
    renderCarouselCards();
  }

  // Global admin delete function
  window.deleteReview = function(id) {
    if (!confirm("Tem a certeza que deseja eliminar esta avaliação de forma permanente?")) return;
    
    if (!deletedReviewIds.includes(id)) {
      deletedReviewIds.push(id);
      localStorage.setItem(deletedReviewsKey, JSON.stringify(deletedReviewIds));
    }
    
    customReviews = customReviews.filter(rev => rev.id !== id);
    localStorage.setItem(globalReviewsKey, JSON.stringify(customReviews));
    
    showSuccessPopup("Avaliação eliminada com sucesso!");
    calculateStatsAndRender();
  };

  function renderCarouselCards() {
    const track = document.getElementById('ReviewsCarouselTrack');
    if (!track) return;

    // Filter out moderated reviews
    const filteredBasePool = baseReviewsPool.filter(rev => !deletedReviewIds.includes(rev.id));
    const filteredCustomPool = customReviews.filter(rev => !deletedReviewIds.includes(rev.id));

    // Custom user-submitted reviews go first
    const mergedPool = [...filteredCustomPool, ...filteredBasePool];

    let trackHtml = '';
    mergedPool.forEach(rev => {
      // Stars
      let starsHtml = '';
      for (let i = 1; i <= 5; i++) {
        if (i <= rev.rating) {
          starsHtml += '<svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>';
        } else {
          starsHtml += '<svg class="empty" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>';
        }
      }

      const initials = rev.name.split(' ').map(w => w[0]).join('').toUpperCase().substring(0, 2);

      trackHtml += `
        <div class="homepage-review-card" style="position: relative;">
          ${isAdminMode ? `<button type="button" class="admin-delete-review-btn" onclick="deleteReview('${rev.id}')" style="position: absolute; top: 12px; right: 12px; background: #dc3545; color: white; border: none; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 11px; cursor: pointer; z-index: 100; box-shadow: 0 2px 5px rgba(0,0,0,0.2); transition: all 0.2s;" title="Eliminar Avaliação (Moderação Admin)">🗑️</button>` : ''}
          <div class="card-header-line">
            <div class="card-rating-stars">
              ${starsHtml}
            </div>
            <span class="card-date">${rev.date}</span>
          </div>
          
          ${rev.title ? `<h4 class="card-review-title">${rev.title}</h4>` : ''}
          <p class="card-review-comment">${rev.comment}</p>
          
          <div class="card-author-line">
            <div class="card-avatar">${initials}</div>
            <div class="card-author-details">
              <span class="card-author-name">${rev.name}</span>
              ${rev.verified ? '<span class="card-verified-badge">Compra Verificada</span>' : ''}
            </div>
          </div>
        </div>
      `;
    });

    track.innerHTML = trackHtml;

    // Render Indicator Dots
    renderIndicatorDots(mergedPool.length);
  }

  function renderIndicatorDots(count) {
    const dotsContainer = document.getElementById('CarouselDotsIndicator');
    const track = document.getElementById('ReviewsCarouselTrack');
    if (!dotsContainer || !track) return;

    let viewSize = 3;
    if (window.innerWidth <= 768) {
      viewSize = 1;
    } else if (window.innerWidth <= 1200) {
      viewSize = 2;
    }

    const steps = Math.ceil(count / viewSize);

    let dotsHtml = '';
    for (let i = 0; i < steps; i++) {
      dotsHtml += `<span class="carousel-dot ${i === 0 ? 'active' : ''}" data-step="${i}"></span>`;
    }
    dotsContainer.innerHTML = dotsHtml;

    // Add click event to dots
    dotsContainer.querySelectorAll('.carousel-dot').forEach(dot => {
      dot.addEventListener('click', function() {
        const step = parseInt(this.getAttribute('data-step'));
        const scrollWidth = track.clientWidth;
        track.scrollLeft = step * scrollWidth;
        
        dotsContainer.querySelectorAll('.carousel-dot').forEach(d => d.classList.remove('active'));
        this.classList.add('active');
      });
    });

    // Sync active dot on scroll
    track.addEventListener('scroll', () => {
      const scrollLeft = track.scrollLeft;
      const scrollWidth = track.clientWidth;
      const activeStep = Math.round(scrollLeft / scrollWidth);
      
      dotsContainer.querySelectorAll('.carousel-dot').forEach((dot, index) => {
        if (index === activeStep) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    });
  }

  // Prev / Next button click handlers
  const prevBtn = document.getElementById('CarouselPrevBtn');
  const nextBtn = document.getElementById('CarouselNextBtn');
  const track = document.getElementById('ReviewsCarouselTrack');

  if (prevBtn && nextBtn && track) {
    prevBtn.addEventListener('click', () => {
      track.scrollLeft -= track.clientWidth;
    });
    
    nextBtn.addEventListener('click', () => {
      track.scrollLeft += track.clientWidth;
    });
  }

  // Listen to window resize to rebuild dots properly
  window.addEventListener('resize', () => {
    const customReviewsLength = JSON.parse(localStorage.getItem(globalReviewsKey) || '[]').length;
    renderIndicatorDots(baseReviewsPool.length + customReviewsLength);
  });

  // Run initial calculation & render
  calculateStatsAndRender();
}

if (document.readyState === 'complete' || document.readyState === 'interactive') {
  initHomepageReviews();
} else {
  document.addEventListener('DOMContentLoaded', initHomepageReviews);
}
</script>

