  margin: 0 auto;
  padding: 5rem 1.5rem;
  background-color: var(--color-bg);
  min-height: 80vh;
}

.about-inner-container {
  max-width: 1100px;
  margin: 0 auto;
}

.about-header {
  text-align: center;
  margin-bottom: 5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.about-title {
  font-size: clamp(2.2rem, 5vw, 3.2rem);
  font-weight: 900;
  color: var(--color-text);
  margin: 0 0 1rem 0;
  letter-spacing: -0.5px;
  text-transform: uppercase;
}

.about-subtitle {
  font-size: clamp(1rem, 2vw, 1.2rem);
  color: var(--color-text-light);
  max-width: 750px;
  line-height: 1.6;
  margin: 0 auto;
}

/* Intro grid styling */
.about-intro-section {
  margin-bottom: 5rem;
}

.about-intro-grid {
  display: grid;
  grid-template-columns: 1.37fr 1fr;
  gap: 4rem;
  align-items: center;
}

.about-intro-text h2 {
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 1.5rem;
  letter-spacing: -0.2px;
}

.about-intro-text p {
  line-height: 1.75;
  color: var(--color-text-light);
  font-size: 1.05rem;
  margin-bottom: 1.2rem;
}

.about-intro-text strong {
  color: var(--color-text);
}

.about-intro-badge-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  padding: 2.8rem 2.2rem;
  border-radius: 24px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.02);
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease, border-color 0.3s ease;
}

.about-intro-badge-card:hover {
  transform: translateY(-4px);
  border-color: rgba(var(--color-primary-rgb), 0.25);
}

.about-badge-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(var(--color-primary-rgb), 0.04);
  color: var(--color-accent);
  padding: 1.2rem;
  border-radius: 50%;
  margin-bottom: 1.5rem;
}

.about-intro-badge-card h3 {
  font-size: 1.3rem;
  font-weight: 850;
  color: var(--color-text);
  margin-bottom: 1rem;
}

.about-intro-badge-card p {
  line-height: 1.6;
  color: var(--color-text-light);
  font-size: 0.95rem;
  margin: 0;
}

/* Mission & Vision Section */
.about-mv-section {
  margin-bottom: 6rem;
}

.about-mv-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
}

.about-mv-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  padding: 3rem 2.5rem;
  border-radius: 20px;
  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.01);
}

.about-mv-card:hover {
  transform: translateY(-3px);
  border-color: rgba(var(--color-primary-rgb), 0.25);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.03);
}

.about-mv-icon {
  color: var(--color-accent);
  margin-bottom: 1.5rem;
  display: inline-flex;
}

.about-mv-card h3 {
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 1rem;
}

.about-mv-card p {
  line-height: 1.65;
  color: var(--color-text-light);
  font-size: 0.98rem;
  margin: 0;
}

/* Values Section */
.about-values-section {
  margin-bottom: 6rem;
}

.about-section-title {
  font-size: 2rem;
  font-weight: 850;
  color: var(--color-text);
  text-align: center;
  margin-bottom: 4rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.about-values-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3.5rem;
}

.about-value-item {
  display: flex;
  gap: 1.5rem;
  align-items: start;
}

.about-value-number {
  font-size: 2.8rem;
