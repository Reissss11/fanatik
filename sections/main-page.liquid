  // --- TEXT HIGHLIGHT HELPER FUNCTION ---
  function highlightText(element, originalHTML, query, highlightClass) {
    if (!query) {
      element.innerHTML = originalHTML;
      return;
    }
    
    // We want to highlight matches in text content without breaking existing HTML tags.
    // A robust simple way: parse the HTML text nodes and wrap query occurrences.
    const temp = document.createElement('div');
    temp.innerHTML = originalHTML;
    
    function recursiveHighlight(node) {
      if (node.nodeType === 3) { // Text node
        const text = node.nodeValue;
        const lowerText = text.toLowerCase();
        const index = lowerText.indexOf(query);
        
        if (index >= 0) {
          const parent = node.parentNode;
          const fragments = [];
          let currentText = text;
          let currentLower = lowerText;
          
          while (true) {
            const idx = currentLower.indexOf(query);
            if (idx < 0) {
              fragments.push(document.createTextNode(currentText));
              break;
            }
            
            // Text before match
            if (idx > 0) {
              fragments.push(document.createTextNode(currentText.substring(0, idx)));
            }
            
            // Match tag
            const mark = document.createElement('mark');
            mark.className = highlightClass;
            mark.textContent = currentText.substring(idx, idx + query.length);
            fragments.push(mark);
            
            currentText = currentText.substring(idx + query.length);
            currentLower = currentLower.substring(idx + query.length);
          }
          
          // Replace node with fragments
          const next = node.nextSibling;
          fragments.forEach(frag => {
            parent.insertBefore(frag, next);
          });
          parent.removeChild(node);
        }
      } else if (node.nodeType === 1 && node.childNodes && !['MARK', 'SCRIPT', 'STYLE'].includes(node.tagName)) {
        // Child elements (excluding mark itself or script/style)
        const children = Array.from(node.childNodes);
        children.forEach(recursiveHighlight);
      }
    }
    
    recursiveHighlight(temp);
    element.innerHTML = temp.innerHTML;
  }
