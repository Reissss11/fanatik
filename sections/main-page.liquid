<script>
document.addEventListener('DOMContentLoaded', function() {
    // --- PRIVACY POLICY CODE ---
  const privacyNavItems = document.querySelectorAll('.privacy-category-nav-item');
  const privacyArticles = document.querySelectorAll('.privacy-category-section');
  const privacyNavContainer = document.querySelector('.privacy-categories-nav');

  if (privacyNavItems.length > 0 && privacyArticles.length > 0) {
    const privacyObserverOptions = {
      root: null,
      rootMargin: '-20% 0px -60% 0px',
      threshold: 0
    };

    const privacyObserver = new IntersectionObserver(function(entries) {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          privacyNavItems.forEach(item => {
            if (item.getAttribute('data-target') === id) {
              item.classList.add('active');
              
              if (window.innerWidth <= 992 && privacyNavContainer) {
                const offsetLeft = item.offsetLeft - (privacyNavContainer.offsetWidth / 2) + (item.offsetWidth / 2);
                privacyNavContainer.scrollTo({
                  left: offsetLeft,
                  behavior: 'smooth'
                });
              }
            } else {
              item.classList.remove('active');
            }
          });
        }
      });
    }, privacyObserverOptions);

    privacyArticles.forEach(article => {
      privacyObserver.observe(article);
    });

    privacyNavItems.forEach(item => {
      item.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('data-target');
        const targetSection = document.getElementById(targetId);
        
        if (targetSection) {
          const headerOffset = window.innerWidth <= 992 ? 150 : 110;
          const elementPosition = targetSection.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
          
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      });
    });
  }

  // Real-time keyword search filter for Privacy Policy
  const privacySearchInput = document.getElementById('PrivacySearchInput');
  const privacySearchClear = document.getElementById('PrivacySearchClear');
  const privacyAccordions = document.querySelectorAll('.privacy-accordion');
  const privacyCategories = document.querySelectorAll('.privacy-category-section');
  const privacyContentArea = document.querySelector('.privacy-content-area');
  let privacyNoResultsEl = null;

  if (privacySearchInput) {
    privacySearchInput.addEventListener('input', function(e) {
      const query = e.target.value.trim().toLowerCase();
      
      if (query.length > 0) {
        privacySearchClear.classList.remove('hidden');
      } else {
        privacySearchClear.classList.add('hidden');
      }
      
      let totalMatches = 0;
      if (privacyNoResultsEl) {
        privacyNoResultsEl.remove();
        privacyNoResultsEl = null;
      }

      privacyCategories.forEach(category => {
        let categoryMatches = 0;
        const accordionsInCat = category.querySelectorAll('.privacy-accordion');
        
        accordionsInCat.forEach(accordion => {
          const qEl = accordion.querySelector('.privacy-question-text');
          const aEl = accordion.querySelector('.privacy-answer-content');
          
          // Original text backup if not already present
          if (!accordion.dataset.originalQ) {
            accordion.dataset.originalQ = qEl.innerHTML;
          }
          if (!accordion.dataset.originalA) {
            accordion.dataset.originalA = aEl.innerHTML;
          }

          const qText = qEl.textContent.toLowerCase();
          const aText = aEl.textContent.toLowerCase();
          
          if (qText.includes(query) || aText.includes(query)) {
            accordion.classList.remove('filtered-out');
            categoryMatches++;
            totalMatches++;
            
            if (query.length >= 2) {
              accordion.setAttribute('open', '');
              
              // Highlight matched text
              highlightText(qEl, accordion.dataset.originalQ, query, 'privacy-highlight');
              highlightText(aEl, accordion.dataset.originalA, query, 'privacy-highlight');
            } else {
              accordion.removeAttribute('open');
              qEl.innerHTML = accordion.dataset.originalQ;
              aEl.innerHTML = accordion.dataset.originalA;
            }
          } else {
            accordion.classList.add('filtered-out');
            accordion.removeAttribute('open');
            qEl.innerHTML = accordion.dataset.originalQ;
            aEl.innerHTML = accordion.dataset.originalA;
          }
        });
        
        if (categoryMatches > 0) {
          category.classList.remove('filtered-out');
        } else {
          category.classList.add('filtered-out');
        }
      });
      
      if (totalMatches === 0 && query.length > 0) {
        privacyNoResultsEl = document.createElement('div');
        privacyNoResultsEl.className = 'privacy-no-results';
        privacyNoResultsEl.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <p>Não foram encontrados artigos para "<strong>${escapeHtml(query)}</strong>"</p>
          <p style="font-size: 0.9rem; margin-top: 0.5rem; opacity: 0.7;">Tente pesquisar por outros termos, como "dados", "cookies", "responsável" ou "retirar".</p>
        `;
        privacyContentArea.appendChild(privacyNoResultsEl);
      }
    });

    privacySearchClear.addEventListener('click', function() {
      privacySearchInput.value = '';
      privacySearchClear.classList.add('hidden');
      if (privacyNoResultsEl) {
        privacyNoResultsEl.remove();
        privacyNoResultsEl = null;
      }
      privacyCategories.forEach(category => {
        category.classList.remove('filtered-out');
        category.querySelectorAll('.privacy-accordion').forEach(accordion => {
          accordion.classList.remove('filtered-out');
