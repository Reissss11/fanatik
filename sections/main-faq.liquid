<style>
/* FAQ Styling - Modern Glassmorphism & Accordion Design System */
.faq-container-wrapper {
  max-width: 100%;
  margin: 0 auto;
  padding: 5rem 1.5rem;
  background-color: var(--color-bg);
  min-height: 80vh;
}

.faq-inner-container {
  max-width: 1200px;
  margin: 0 auto;
}

.faq-header {
  text-align: center;
  margin-bottom: 4rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.faq-title {
  font-size: clamp(2.2rem, 5vw, 3.2rem);
  font-weight: 900;
  color: var(--color-text);
  margin: 0 0 1rem 0;
  letter-spacing: -0.5px;
}

.faq-subtitle {
  font-size: clamp(0.95rem, 2vw, 1.15rem);
  color: var(--color-text-light);
  max-width: 600px;
  line-height: 1.6;
  margin: 0 0 2.5rem 0;
}

/* FAQ Search Input Style */
.faq-search-wrapper {
  width: 100%;
  max-width: 540px;
  position: relative;
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 50px;
  padding: 0.2rem 0.5rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  transition: all 0.3s ease;
}

.faq-search-wrapper:focus-within {
  border-color: var(--color-accent);
  box-shadow: 0 6px 24px rgba(var(--color-primary-rgb), 0.08);
  transform: translateY(-1px);
}

.faq-search-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.8rem;
  color: var(--color-text-light);
  pointer-events: none;
}

.faq-search-wrapper input {
  flex: 1;
  border: none;
  background: transparent;
  padding: 0.8rem 0.2rem;
  font-size: 1rem;
  color: var(--color-text);
  outline: none;
  font-family: inherit;
}

.faq-search-wrapper input::placeholder {
  color: var(--color-text-light);
  opacity: 0.8;
}

.faq-search-clear {
  background: transparent;
  border: none;
  color: var(--color-text-light);
  cursor: pointer;
  padding: 0.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.faq-search-clear:hover {
  color: var(--color-text);
  background: rgba(var(--color-primary-rgb), 0.05);
}

.faq-search-clear.hidden {
  display: none;
}

/* Main FAQ Columns Layout */
.faq-main-layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 4rem;
  align-items: start;
}

/* Sidebar Navigation */
.faq-sidebar {
  position: sticky;
  top: 100px;
  z-index: 10;
}

.faq-categories-nav {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  background: rgba(var(--color-surface-rgb), 0.5);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid var(--color-border);
  padding: 1rem;
  border-radius: 20px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
}

.faq-category-nav-item {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 0.9rem 1.2rem;
  border-radius: 12px;
  color: var(--color-text-light);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  transition: all 0.25s ease;
  border: 1px solid transparent;
}

.faq-category-nav-item svg {
  stroke-width: 2.2px;
  transition: transform 0.2s ease;
  flex-shrink: 0;
}

.faq-category-nav-item:hover {
  color: var(--color-text);
  background: rgba(var(--color-primary-rgb), 0.03);
}

.faq-category-nav-item:hover svg {
  transform: scale(1.05);
}

.faq-category-nav-item.active {
  color: #ffffff;
  background: var(--color-text); /* Matches theme high contrast */
  border-color: var(--color-text);
  box-shadow: 0 4px 12px rgba(var(--color-primary-rgb), 0.15);
}

html[data-theme="dark"] .faq-category-nav-item.active {
  color: #0b0b0b;
  background: #ffffff;
  border-color: #ffffff;
}

.faq-category-nav-item.active svg {
  color: inherit;
}

/* Accordion sections */
.faq-content-area {
  display: flex;
  flex-direction: column;
  gap: 4.5rem;
}

.faq-category-section {
  scroll-margin-top: 100px;
}

.faq-category-title {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--color-text);
  margin: 0 0 1.8rem 0;
  padding-bottom: 0.8rem;
  border-bottom: 2px solid var(--color-border);
}

.faq-accordions-group {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* Accordion Styles */
.faq-accordion {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 16px;
  overflow: hidden;
  transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.01);
}

.faq-accordion:hover {
  border-color: rgba(var(--color-primary-rgb), 0.3);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.03);
}

.faq-accordion[open] {
  border-color: var(--color-text);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
}

.faq-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.4rem 1.8rem;
  font-weight: 700;
  font-size: 1.05rem;
  cursor: pointer;
  color: var(--color-text);
  user-select: none;
  list-style: none;
}

.faq-summary::-webkit-details-marker {
  display: none;
}

.faq-question-text {
  line-height: 1.4;
  padding-right: 1.5rem;
}

.faq-icon-chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-light);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), color 0.3s ease;
  flex-shrink: 0;
}

.faq-icon-chevron svg {
  stroke-width: 2.5px;
}

.faq-accordion[open] .faq-icon-chevron {
  transform: rotate(180deg);
  color: var(--color-text);
}

.faq-answer-content {
  padding: 0 1.8rem 1.6rem 1.8rem;
  border-top: 1px solid transparent;
  color: var(--color-text-light);
  line-height: 1.65;
  font-size: 0.98rem;
  animation: faqSlideDown 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

.faq-accordion[open] .faq-answer-content {
  border-top-color: var(--color-border);
}

.faq-answer-content p {
  margin: 0;
}

.faq-link {
  color: var(--color-text);
  text-decoration: underline;
  font-weight: 600;
  transition: color 0.2s ease;
}

.faq-link:hover {
  color: var(--color-accent);
}

/* Animations */
@keyframes faqSlideDown {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Highlight search styling */
.faq-highlight {
  background-color: rgba(184, 151, 106, 0.25);
  color: var(--color-text);
  padding: 0 2px;
  border-radius: 4px;
  font-weight: bold;
}

.faq-accordion.filtered-out {
  display: none !important;
}

.faq-category-section.filtered-out {
  display: none !important;
}

.faq-no-results {
  text-align: center;
  padding: 4rem 1rem;
  color: var(--color-text-light);
  font-size: 1.1rem;
}

.faq-no-results svg {
  margin-bottom: 1rem;
  opacity: 0.5;
  color: var(--color-text-light);
}

/* Responsive Styling */
@media (max-width: 992px) {
  .faq-container-wrapper {
    padding: 3rem 1rem;
  }
  
  .faq-header {
    margin-bottom: 2.5rem;
  }

  .faq-main-layout {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .faq-sidebar {
    position: sticky;
    top: 60px; /* Below standard sticky header */
    margin: 0 -1rem;
    padding: 0 1rem;
    background: var(--color-bg);
  }

  .faq-categories-nav {
    flex-direction: row;
    overflow-x: auto;
    white-space: nowrap;
    padding: 0.6rem;
    border-radius: 12px;
    gap: 0.4rem;
    scrollbar-width: none; /* Hide scrollbar for clean aesthetics */
  }
  
  .faq-categories-nav::-webkit-scrollbar {
    display: none;
  }

  .faq-category-nav-item {
    padding: 0.7rem 1rem;
    font-size: 0.88rem;
  }
  
  .faq-content-area {
    gap: 3rem;
  }
  
  .faq-category-section {
    scroll-margin-top: 130px;
  }
  
  .faq-category-title {
    font-size: 1.4rem;
    margin-bottom: 1.2rem;
  }
  
  .faq-summary {
    padding: 1.2rem 1.4rem;
    font-size: 0.98rem;
  }
  
  .faq-answer-content {
    padding: 0 1.4rem 1.4rem 1.4rem;
    font-size: 0.92rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('FaqSearchInput');
  const clearBtn = document.getElementById('FaqSearchClear');
  const accordions = document.querySelectorAll('.faq-accordion');
  const categories = document.querySelectorAll('.faq-category-section');
  const navItems = document.querySelectorAll('.faq-category-nav-item');
  const contentArea = document.querySelector('.faq-content-area');
  
  let noResultsEl = null;

  // Real-time Search and Filtering
  if (searchInput) {
    searchInput.addEventListener('input', function(e) {
      const query = e.target.value.trim().toLowerCase();
      
      if (query.length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
      
      let totalMatches = 0;
      
      // Remove any existing no-results message
      if (noResultsEl) {
        noResultsEl.remove();
        noResultsEl = null;
      }

      categories.forEach(category => {
        let categoryMatches = 0;
        const accordionsInCat = category.querySelectorAll('.faq-accordion');
        
        accordionsInCat.forEach(accordion => {
          const qText = accordion.querySelector('.faq-question-text').textContent.toLowerCase();
          const aText = accordion.querySelector('.faq-answer-content').textContent.toLowerCase();
          
          if (qText.includes(query) || aText.includes(query)) {
            accordion.classList.remove('filtered-out');
            categoryMatches++;
            totalMatches++;
            
            // Auto expand matching accordions during search so answers are visible immediately
            if (query.length >= 2) {
              accordion.setAttribute('open', '');
            } else {
              accordion.removeAttribute('open');
            }
          } else {
            accordion.classList.add('filtered-out');
            accordion.removeAttribute('open');
          }
        });
        
        if (categoryMatches > 0) {
          category.classList.remove('filtered-out');
        } else {
          category.classList.add('filtered-out');
        }
      });
      
      // Show "No Results Found" if nothing matches
      if (totalMatches === 0 && query.length > 0) {
        noResultsEl = document.createElement('div');
        noResultsEl.className = 'faq-no-results';
        noResultsEl.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <p>Não foram encontrados resultados para "<strong>${escapeHtml(query)}</strong>"</p>
          <p style="font-size: 0.9rem; margin-top: 0.5rem; opacity: 0.7;">Tente pesquisar por outros termos, como "envio", "tamanho" ou "reembolso".</p>
        `;
        contentArea.appendChild(noResultsEl);
      }
    });
  }

  // Clear Search Button
  if (clearBtn) {
    clearBtn.addEventListener('click', function() {
      searchInput.value = '';
      clearBtn.classList.add('hidden');
      if (noResultsEl) {
        noResultsEl.remove();
        noResultsEl = null;
      }
      categories.forEach(category => {
        category.classList.remove('filtered-out');
        category.querySelectorAll('.faq-accordion').forEach(accordion => {
          accordion.classList.remove('filtered-out');
          accordion.removeAttribute('open');
        });
      });
      searchInput.focus();
    });
  }

  // Helper function to escape HTML search strings
  function escapeHtml(str) {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
  }

  // Sticky Categories Navigation Active Link Scrolling Spy
  const observerOptions = {
    root: null,
    rootMargin: '-20% 0px -60% 0px', // Triggers active link change when section is centered
    threshold: 0
  };

  const observer = new IntersectionObserver(function(entries) {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        navItems.forEach(item => {
          if (item.getAttribute('data-target') === id) {
            item.classList.add('active');
            
            // Auto-scroll the horizontal category nav bar on mobile to keep active item in view
            if (window.innerWidth <= 992) {
              const navContainer = document.querySelector('.faq-categories-nav');
              const offsetLeft = item.offsetLeft - (navContainer.offsetWidth / 2) + (item.offsetWidth / 2);
              navContainer.scrollTo({
                left: offsetLeft,
                behavior: 'smooth'
              });
            }
          } else {
            item.classList.remove('active');
          }
        });
      }
    });
  }, observerOptions);

  categories.forEach(category => {
    observer.observe(category);
  });

  // Smooth Scroll Click Handlers for Categories Navigation
  navItems.forEach(item => {
    item.addEventListener('click', function(e) {
      e.preventDefault();
      const targetId = this.getAttribute('data-target');
      const targetSection = document.getElementById(targetId);
      
      if (targetSection) {
        const headerOffset = window.innerWidth <= 992 ? 140 : 110;
        const elementPosition = targetSection.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
        
        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth'
        });
      }
    });
  });
});
</script>

