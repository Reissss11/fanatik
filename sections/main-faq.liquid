      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Encontre respostas às perguntas mais frequentes sobre encomendas, envios, devoluções e mais."
    }
  ]
}
