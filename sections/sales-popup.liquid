<!-- Sections: Sales Pop-up (FOMO Sales Notification Toast) -->
<section id="SalesPopupNotification" class="sales-popup-wrapper" aria-live="polite">
  <div class="sales-popup-card" id="SalesPopupCard">
    <button type="button" class="sales-popup-close" id="SalesPopupCloseBtn" aria-label="Fechar notificação">✕</button>
    
    <div class="sales-popup-content">
      <!-- Column 1: Clean green checkmark circle icon -->
      <div class="sales-popup-icon-wrap">
        <div class="sales-popup-circle-check">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#10b981" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
      </div>
      
      <!-- Column 2: Stacked text details matching mockup without city -->
      <div class="sales-popup-details">
        <div class="sales-popup-subtitle-row">
          <span class="sales-popup-subtitle">Acabou de Comprar</span>
          <span class="meta-separator-sub">•</span>
          <span class="meta-relative-time" id="SalesPopupTime">Agora mesmo</span>
        </div>
        <h4 class="sales-popup-purchased">
          <span id="SalesPopupBuyerName" class="buyer-name"></span>
        </h4>
        <div class="sales-popup-meta">
          <span id="SalesPopupProductTitle" class="product-title-text"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sales Pop-up Styles -->
<style>
.sales-popup-wrapper {
  position: fixed !important;
  bottom: 24px !important;
  left: 24px !important;
  right: auto !important;
  z-index: 99999 !important;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  pointer-events: none;
}

.sales-popup-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  border-radius: 20px;
  padding: 14px 18px;
  width: 320px;
  position: relative;
  transform: translateY(120px) scale(0.9);
  opacity: 0;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
  pointer-events: auto;
}

.sales-popup-card.show {
  transform: translateY(0) scale(1) !important;
  opacity: 1 !important;
}

.sales-popup-close {
  position: absolute;
  top: 8px;
  right: 12px;
  background: transparent;
  border: none;
  font-size: 0.72rem;
  font-weight: 700;
  color: #999999;
  cursor: pointer;
  opacity: 0.4;
  transition: opacity 0.2s, transform 0.1s;
  padding: 4px;
}

.sales-popup-close:hover {
  opacity: 0.9;
  transform: scale(1.15);
}

.sales-popup-content {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  width: 100%;
}

.sales-popup-icon-wrap {
  flex-shrink: 0;
  margin-top: 3px;
}

.sales-popup-circle-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.1);
  border: 1.5px solid rgba(16, 185, 129, 0.2);
}

.sales-popup-details {
  display: flex;
  flex-direction: column;
  text-align: left;
  overflow: hidden;
  padding-right: 10px;
}

.sales-popup-subtitle-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 2px;
  line-height: 1;
}

.sales-popup-subtitle {
  font-size: 0.8rem;
  font-weight: 600;
  color: #666666;
  letter-spacing: -0.01em;
  line-height: 1;
}

.meta-separator-sub {
  color: #cccccc;
  font-size: 0.8rem;
  font-weight: 300;
  line-height: 1;
}

.meta-relative-time {
  color: #888888;
  font-size: 0.8rem;
  font-weight: 400;
  white-space: nowrap;
  line-height: 1;
}

.sales-popup-purchased {
  font-size: 0.92rem;
  color: #333333;
  margin: 0 0 4px 0;
  line-height: 1.2;
  font-weight: 400;
  letter-spacing: -0.01em;
}

.sales-popup-purchased .buyer-name {
  font-weight: 700;
  color: #111111;
}

.sales-popup-meta {
  display: flex;
  align-items: center;
  line-height: 1.2;
}

.product-title-text {
  color: #777777;
  font-weight: 400;
  font-size: 0.82rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 250px; /* Increased width since the metadata row no longer has the time badge */
}

/* Dark Mode styles matching premium dark theme variables */
[data-theme="dark"] .sales-popup-card {
  background: #18181b !important;
  border-color: rgba(255, 255, 255, 0.08) !important;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4) !important;
}

[data-theme="dark"] .sales-popup-subtitle {
  color: #a1a1aa !important;
}

[data-theme="dark"] .meta-separator-sub {
  color: #52525b !important;
}

[data-theme="dark"] .meta-relative-time {
  color: #71717a !important; /* Zinc text color for modern clean hierarchy */
}

[data-theme="dark"] .sales-popup-purchased {
  color: #f4f4f5 !important;
}

[data-theme="dark"] .sales-popup-purchased .buyer-name {
  color: #ffffff !important;
}

[data-theme="dark"] .product-title-text {
  color: #a1a1aa !important;
}

[data-theme="dark"] .sales-popup-close {
  color: #a1a1aa !important;
}

[data-theme="dark"] .sales-popup-circle-check {
  background: rgba(16, 185, 129, 0.2) !important;
  border-color: rgba(16, 185, 129, 0.3) !important;
}

/* Responsive Adaptive positioning to prevent overlap with Mobile Footer Navigation */
@media (max-width: 992px) {
  .sales-popup-wrapper {
    bottom: 80px !important; /* Shifted higher up to clear mobile bottom navigation */
    left: 16px !important;
    right: 16px !important;
    display: flex;
    justify-content: center;
  }
  
  .sales-popup-card {
    width: 100%;
    max-width: 320px;
  }
}
</style>

<!-- Sales Pop-up Javascript -->
<script>
(function() {
  /* Query all active products in the store via Shopify Liquid limit and output as JS Array */
  {% paginate collections.all.products by 100 %}
    const liveProductsPool = [
      {% for product in collections.all.products %}
        {
          title: {{ product.title | json }},
          url: {{ product.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ];
  {% endpaginate %}

  /* Fallback products list in case store is fresh */
  const fallbackProductsPool = [
    { title: "Real Madrid Principal 25/26" },
    { title: "Real Madrid Alternativa Retro" },
    { title: "Benfica Alternativa 24/25" },
    { title: "Portugal Edição Especial Retro" },
    { title: "Sporting Principal 24/25" },
    { title: "FC Porto Principal 24/25" }
  ];

  const productsPool = liveProductsPool.length > 0 ? liveProductsPool : fallbackProductsPool;

  /* PT-PT Name pools for sales notification */
  const firstNames = [
    "Carlos", "Ana", "Luís", "Vítor", "Beatriz", "José", "Rui", "Cláudia", "Tiago", "Diana",
    "Marco", "Sara", "Pedro", "Maria", "João", "Filipa", "Ricardo", "Inês", "Miguel", "Sofia",
    "António", "Rita", "Francisco", "Mariana", "Gonçalo", "Leonor", "Diogo", "Madalena", "Gustavo", "Carolina",
    "Daniel", "Catarina", "Nuno", "Patrícia", "André", "Joana", "Jorge", "Marta", "Manuel", "Camila"
  ];
  const lastInitials = ["M.", "S.", "A.", "P.", "R.", "F.", "G.", "O.", "C.", "L.", "H.", "T.", "D.", "V.", "N.", "B."];

  const sizes = ["S", "M", "L", "XL"];

  /* Helper relative time list */
  const times = [
    "Agora mesmo", "Há 1 minuto", "Há 2 minutos", "Há 3 minutos", "Há 5 minutos", "Há 8 minutos",
    "Há 10 minutos", "Há 15 minutos", "Há 20 minutos", "Há 30 minutos"
  ];

  /* Self-healing DOM Initializer */
  function initSalesPopup() {
    const wrapper = document.getElementById('SalesPopupNotification');
    const popupCard = document.getElementById('SalesPopupCard');
    const closeBtn = document.getElementById('SalesPopupCloseBtn');
    const buyerNameEl = document.getElementById('SalesPopupBuyerName');
    const productTitleEl = document.getElementById('SalesPopupProductTitle');
    const timeEl = document.getElementById('SalesPopupTime');

    /* If elements are not found yet, wait and retry safely */
    if (!wrapper || !popupCard || !buyerNameEl || !productTitleEl || !timeEl) {
      setTimeout(initSalesPopup, 150);
      return;
    }

    /* Move notification wrapper directly to document.body to prevent layout/transform clipping and guarantee it stays sticky relative to viewport */
    document.body.appendChild(wrapper);

    let popupTimeout = null;
    let cycleInterval = null;

    /* Show popup helper */
    function showPopup() {
      popupCard.classList.add('show');
      
      /* Auto-hide popup after exactly 10 seconds (as requested: "dure 10s e dps desapareça") */
      if (popupTimeout) clearTimeout(popupTimeout);
      popupTimeout = setTimeout(hidePopup, 10000);
    }

    /* Hide popup helper */
    function hidePopup() {
      popupCard.classList.remove('show');
      if (popupTimeout) {
        clearTimeout(popupTimeout);
        popupTimeout = null;
      }
    }

    /* Function to show a random new fake sale */
    function triggerRandomSale() {
      if (productsPool.length === 0) return;

      const randomFirstName = firstNames[Math.floor(Math.random() * firstNames.length)];
      const randomLastInitial = lastInitials[Math.floor(Math.random() * lastInitials.length)];
      const randomTime = times[Math.floor(Math.random() * times.length)];
      
      /* Choose purchase quantity (1 to 5 jerseys as requested!) */
      const quantity = Math.floor(Math.random() * 5) + 1;
      let purchaseText = "";
      let mainProduct = productsPool[Math.floor(Math.random() * productsPool.length)];

      if (quantity === 1) {
        purchaseText = mainProduct.title;
      } else {
        const otherJerseys = [];
        const jerseysToSelect = Math.min(quantity - 1, productsPool.length);
        for (let j = 0; j < jerseysToSelect; j++) {
          const otherProd = productsPool[Math.floor(Math.random() * productsPool.length)];
          if (otherProd.title !== mainProduct.title && !otherJerseys.includes(otherProd.title)) {
            otherJerseys.push(otherProd.title);
          }
        }
        
        const otherCount = quantity - 1;
        if (otherJerseys.length > 0) {
          purchaseText = `${quantity} camisolas (${mainProduct.title} + ${otherCount === 1 ? otherJerseys[0] : otherCount + ' outras'})`;
        } else {
          purchaseText = `${quantity} camisolas do modelo ${mainProduct.title}`;
        }
      }

      buyerNameEl.innerText = `${randomFirstName} ${randomLastInitial}`;
      productTitleEl.innerText = purchaseText;
      timeEl.innerText = randomTime;

      if (mainProduct.url) {
        popupCard.style.cursor = "pointer";
        popupCard.onclick = function(e) {
          if (e.target !== closeBtn) {
            window.location.href = mainProduct.url;
          }
        };
      } else {
        popupCard.style.cursor = "default";
        popupCard.onclick = null;
      }

      showPopup();
    }

    /* Dismiss button action */
    if (closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        hidePopup();
        
        /* Reset the 5-minute cycle interval if manually closed, giving a fresh 5 minutes wait */
        clearInterval(cycleInterval);
        startNotificationCycle();
      });
    }

    /* Interval function to start loop cycle strictly every 5 minutes (300000ms) */
    function startNotificationCycle() {
      clearInterval(cycleInterval);
      cycleInterval = setInterval(() => {
        if (!popupCard.classList.contains('show')) {
          triggerRandomSale();
        }
      }, 300000);
    }

    /* Trigger a random sale 1.5 seconds after load, and initialize the 5 minutes interval */
    setTimeout(() => {
      triggerRandomSale();
      startNotificationCycle();
    }, 1500);
  }

  /* Safely trigger when DOM is parsed */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSalesPopup);
  } else {
    initSalesPopup();
  }
})();
</script>

{% schema %}
{
  "name": "Sales Pop-up (FOMO)",
  "settings": [],
  "presets": [
    {
      "name": "Sales Pop-up (FOMO)",
      "category": "Marketing"
    }
  ]
}
{% endschema %}
