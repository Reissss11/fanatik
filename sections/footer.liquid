<footer class="footer">
  <div class="footer-content">
    <!-- Left Column: Contactos (Big) & Redes Sociais -->
    <div class="footer-section contacts-left">
      <h2>{{ section.settings.contact_title }}</h2>
      <p class="contact-email-large">
        Email: <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
      </p>

      <h3 class="social-title-left">{{ section.settings.social_title }}</h3>
      <div class="social-icons-left">
        {%- assign instagram_url = settings.social_instagram_link | default: section.settings.instagram_link -%}
        {%- if instagram_url != blank -%}
          <a
            href="{{ instagram_url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="social-icon"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        {%- endif -%}

        {%- assign tiktok_url = settings.social_tiktok_link | default: section.settings.tiktok_link -%}
        {%- if tiktok_url != blank -%}
          <a
            href="{{ tiktok_url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
            class="social-icon"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
          </a>
        {%- endif -%}

        {%- assign facebook_url = settings.social_facebook_link | default: section.settings.facebook_link -%}
        {%- if facebook_url != blank -%}
          <a
            href="{{ facebook_url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="social-icon"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        {%- endif -%}

        {%- assign twitter_url = settings.social_twitter_link | default: section.settings.twitter_link -%}
        {%- if twitter_url != blank -%}
          <a
            href="{{ twitter_url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X/Twitter"
            class="social-icon"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- Center Column 1: Ajuda e Contactos -->
    <div class="footer-section links-column">
      <h3>Ajuda e Contactos</h3>
      <ul>
        <li><a href="/pages/faq">FAQ</a></li>
        <li><a href="/pages/sobre-nos">Sobre nós</a></li>
        <li><a href="/pages/envio-e-entrega">Envio e Entrega</a></li>
        <li><a href="/pages/satisfacao-garantida">Satisfação garantida</a></li>
      </ul>
    </div>

    <!-- Center Column 2: Políticas -->
    <div class="footer-section links-column">
      <h3>Políticas</h3>
      <ul>
        <li><a href="/pages/politica-de-privacidade">Política de Privacidade</a></li>
        <li><a href="/pages/trocas-e-devolucoes">Trocas & Devoluções</a></li>
        <li><a href="/pages/envio-e-entrega">Política de Envio</a></li>
        <li><a href="/pages/termos-de-servico">Termos de Serviço</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé (Footer)",
  "settings": [
    {
      "type": "text",
      "id": "contact_title",
      "label": "Título de Contactos",
      "default": "Contactos"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email de Contacto",
      "default": "fanatikjersey2@gmail.com"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Título de Redes Sociais",
      "default": "Redes Sociais"
    },
    {
      "type": "text",
      "id": "instagram_link",
      "label": "Instagram URL (Alternativo)",
      "default": "https://www.instagram.com/fanatik_jersey/"
    },
    {
      "type": "text",
      "id": "tiktok_link",
      "label": "TikTok URL (Alternativo)",
      "default": "https://www.tiktok.com/@drible.wear"
    },
    {
      "type": "text",
      "id": "facebook_link",
      "label": "Facebook URL (Alternativo)"
    },
    {
      "type": "text",
      "id": "twitter_link",
      "label": "Twitter/X URL (Alternativo)"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Texto dos Direitos Autorais",
      "default": "Todos os direitos reservados."
    }
  ]
}
{% endschema %}
