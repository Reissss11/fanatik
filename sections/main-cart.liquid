<div class="cart-page-container">
  <div class="cart-page-content" id="MainCartContent">
    <h1 class="cart-page-title">{{ 'general.cart.title' | t }} ({{ cart.item_count }})</h1>

    {%- if cart.item_count == 0 -%}
      <div class="empty-cart-page">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="empty-icon">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <p>{{ 'general.cart.empty' | t }}</p>
        <a href="/collections/all" class="start-shopping-btn">{{ 'general.cart.start_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-form-page">
        <div class="cart-page-grid">
          <!-- Items List -->
          <div class="cart-page-items">
            {%- for item in cart.items -%}
              <div class="cart-item-row" data-key="{{ item.key }}">
                <div class="cart-item-image">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}">
                  {%- endif -%}
                </div>

                <div class="cart-item-details">
                  <h3>{{ item.product.title | escape }}</h3>
                  <p class="item-meta">
                    {%- unless item.product.has_only_default_variant -%}
                      {{ item.variant.title | escape }}
                    {%- endunless -%}
                  </p>

                  <!-- Line Item Properties (Personalization) -->
                  {%- assign property_size = item.properties | size -%}
                  {%- if property_size > 0 -%}
                    <div class="item-properties-list">
                      {%- for property in item.properties -%}
                        {%- assign first_character_in_key = property.first | slice: 0 -%}
                        {%- if property.last != blank and first_character_in_key != '_' -%}
                          <p class="item-property">
                            <strong>{{ property.first }}:</strong> {{ property.last }}
                          </p>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  <div class="price-and-qty-row">
                    <span class="item-price">{{ item.final_line_price | money }}</span>
                    
                    <div class="qty-selector">
                      <button type="button" class="qty-btn minus" data-qty-change="-1">-</button>
                      <input
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        class="qty-input"
                        id="Quantity-{{ item.index | plus: 1 }}"
                        data-key="{{ item.key }}"
                      >
                      <button type="button" class="qty-btn plus" data-qty-change="1">+</button>
                    </div>
                  </div>
                </div>

                <div class="cart-item-actions">
                  <a href="{{ item.url_to_remove }}" class="remove-item-btn" aria-label="{{ 'general.cart.remove' | t }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      <line x1="10" y1="11" x2="10" y2="17"></line>
                      <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                  </a>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <!-- Checkout Summary -->
          <div class="cart-page-sidebar">
            <div class="summary-box">
              <h2>Resumo do Pedido</h2>

              {%- if cart.item_count >= 3 -%}
                <!-- Surcharge Discount Banner -->
                <div class="discount-message">
                  🎉 Desconto Aplicado! Economiza na compra conjunta das tuas camisolas.
                </div>
              {%- endif -%}

              <div class="summary-row subtotal">
                <span>{{ 'general.cart.subtotal' | t }}</span>
                <span>{{ cart.total_price | money }}</span>
              </div>

              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <div class="summary-discounts">
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <div class="summary-row discount">
                      <span>Desconto ({{ discount.title }})</span>
                      <span>-{{ discount.total_allocated_amount | money }}</span>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <div class="summary-row total">
                <span>{{ 'general.cart.total' | t }}</span>
                <span>{{ cart.total_price | money }}</span>
              </div>

              <div class="checkout-actions">
                <button type="submit" name="checkout" class="checkout-btn">
                  {{ 'general.cart.checkout' | t }}
                </button>
                
                <a href="/collections/all" class="continue-shopping">
                  Continuar a Comprar
                </a>
              </div>
            </div>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Página de Carrinho",
  "settings": []
}
{% endschema %}
