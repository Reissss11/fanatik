<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Pre-render Theme Toggler to Prevent Flashing (FOUC) -->
    <script>
      (function() {
        const storedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', storedTheme);
      })();
    </script>

    <!-- PWA & Mobile App Capability Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Fanatik">
    <meta name="mobile-web-app-capable" content="yes">

    <!-- Dynamic CSS Variables from Shopify Settings -->
    <style>
      :root {
        --color-bg: {{ settings.color_bg_light | default: '#ffffff' }};
        --color-text: {{ settings.color_text_light | default: '#1a1a1a' }};
        --color-text-light: #707070;
        --color-primary: {{ settings.color_primary | default: '#000000' }};
        --color-secondary: #f3f3f3;
        --color-accent: {{ settings.color_accent | default: '#E11931' }};
        --color-border: {{ settings.color_border_light | default: '#e5e5e5' }};
        --color-surface: {{ settings.color_surface_light | default: '#ffffff' }};
        --color-surface-rgb: 255, 255, 255;
        --color-surface-hover: #f9f9f9;
        --color-primary-rgb: 0, 0, 0;
        --font-family: 'Inter', system-ui, -apple-system, sans-serif;
        --card-bg: #ffffff;
      }

      [data-theme='dark'] {
        --color-bg: {{ settings.color_bg_dark | default: '#121212' }};
        --color-text: {{ settings.color_text_dark | default: '#ffffff' }};
        --color-text-light: #a0a0a0;
        --color-primary: {{ settings.color_primary_dark | default: '#ffffff' }};
        --color-secondary: #1e1e1e;
        --color-border: {{ settings.color_border_dark | default: '#333333' }};
        --color-surface: {{ settings.color_surface_dark | default: '#1e1e1e' }};
        --color-surface-rgb: 30, 30, 30;
        --color-surface-hover: #2a2a2a;
        --color-primary-rgb: 255, 255, 255;
        --card-bg: #1e1e1e;
      }
    </style>

    {{ content_for_header }}

    <!-- Theme CSS -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>

  <body>
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      Voltar para o conteúdo
    </a>

    <!-- Header Section -->
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer Section -->
    {% section 'footer' %}

    <!-- Slideout Cart Drawer snippet -->
    {% render 'cart-drawer' %}

    <!-- JavaScript Variables passed from Liquid to theme.js -->
    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
      window.cartStrings = {
        error: `Erro ao atualizar carrinho. Tente novamente.`,
        quantityError: `Quantidade limite excedida.`
      };
    </script>

    <!-- Theme JS -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    <!-- Mobile Bottom Navigation Bar (App Experience) -->
    <div class="mobile-bottom-nav">
      <a href="{{ routes.root_url }}" class="mobile-bottom-nav-item {% if request.path == routes.root_url %}active{% endif %}">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Início</span>
      </a>

      <a href="/collections/all" class="mobile-bottom-nav-item {% if request.path == '/collections/all' %}active{% endif %}">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="21" x2="4" y2="14"></line>
          <line x1="4" y1="10" x2="4" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12" y2="3"></line>
          <line x1="20" y1="21" x2="20" y2="16"></line>
          <line x1="20" y1="12" x2="20" y2="3"></line>
          <line x1="1" y1="14" x2="7" y2="14"></line>
          <line x1="9" y1="8" x2="15" y2="8"></line>
          <line x1="17" y1="16" x2="23" y2="16"></line>
        </svg>
        <span>Ver Todas</span>
      </a>

      <button type="button" class="mobile-bottom-nav-item mobile-cart-trigger" id="MobileCartTrigger">
        <div class="mobile-cart-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span class="cart-badge {% if cart.item_count == 0 %}hidden{% endif %}" id="MobileCartBadge">
            {{ cart.item_count }}
          </span>
        </div>
        <span>Carrinho</span>
      </button>

      {%- if shop.customer_accounts_enabled -%}
        {%- assign account_url = routes.account_url -%}
        {%- unless customer -%}
          {%- assign account_url = routes.account_login_url -%}
        {%- endunless -%}
        <a href="{{ account_url }}" class="mobile-bottom-nav-item {% if request.path == routes.account_url or request.path == routes.account_login_url %}active{% endif %}">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>Conta</span>
        </a>
      {%- endif -%}
    </div>
  </body>
</html>
